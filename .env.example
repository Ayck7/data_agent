# ============================================================
#  环境变量模板
#  复制本文件为 .env，填入你自己的值：
#      Windows PowerShell：  copy .env.example .env
#  注意：.env 已被 .gitignore 排除，不会上传到 GitHub
# ============================================================

# ---------- DeepSeek API Key（必填）----------
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的真实Key

# ---------- 演示口令（可选）----------
# 设置后，Streamlit 页面需要输入口令才能使用。
# 公网演示时强烈建议设置——否则任何拿到链接的人都能消耗你的 API 额度。
# DEMO_PASSWORD=your-demo-password
